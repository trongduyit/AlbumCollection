# Auto detect text files and normalize line endings to LF
* text=auto

# Source code
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files
*.mp4 binary
*.mp3 binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary

# Documents
*.pdf binary
